# ==========================================================
# PORT / TLS
# ==========================================================
#
# Intercept mode (RoadMap.md's "Squid: explicit-proxy-with-login ->
# transparent intercept" section, locked 2026-08-30): nftables NAT-redirects
# a bump_v4 device's own port 80/443 traffic to the ports below (see
# phase3/nftables-manager/internal/nft/knftables_adapter.go's baselineRules)
# -- no device ever configures a proxy address or port itself. Squid
# recovers the real destination from the redirected socket via
# SO_ORIGINAL_DST, which `intercept` (plain HTTP) and `intercept ssl-bump`
# (HTTPS, since it also has to terminate TLS to peek/bump) both require. The
# CA certificate below is still the one manual step needed on a bump-enabled
# device -- nothing else changes there.
#
# This replaces the old explicit-proxy http_port (see git history, not here)
# that required each device to be manually pointed at Squid's address --
# fundamentally incompatible with NAT-redirected traffic anyway, since
# intercepted connections never send a CONNECT for HTTPS in the first place.

# Loopback-only, deliberately NOT intercept: an intercept-only Squid (no
# conventional forward-proxy http_port at all) has no "normal" address to
# build its own internal URLs from (used for built-in icons, e.g. FTP
# directory listings) -- it computes host:0 and FATALs at startup with
# "mimeLoadIcon: cannot parse internal URL", before ever opening the real
# intercept ports below. Confirmed live 2026-08-30, the first time this
# config was ever booted against a real Squid binary. Nothing routes real
# traffic here; it exists purely so that URL construction has somewhere
# valid to point at.
http_port 127.0.0.1:3128

http_port 3129 intercept

https_port 3130 intercept ssl-bump generate-host-certificates=on \
dynamic_cert_mem_cache_size=4MB \
cert=/config/ssl_cert/ca_cert.pem \
key=/config/ssl_cert/ca_key.pem \
tls-min-version=1.2 \
tls-options=NO_TLSv1,NO_TLSv1_1

sslcrtd_program /usr/lib/squid/security_file_certgen \
-s /var/lib/squid/ssl_db \
-M 4MB

sslcrtd_children 5 startup=1 idle=1


# ==========================================================
# HOST HEADER / INTERCEPTED-DESTINATION VERIFICATION
# ==========================================================
# RoadMap.md finding #6 (2026-09-10 QUIC/Crunchyroll trace). With this
# left at Squid's stricter behaviour, an intercepted connection whose
# real destination IP is not in Squid's OWN fresh re-resolution of the
# SNI/Host name is killed outright with `SECURITY ALERT: Host header
# forgery detected` + NONE_NONE/409. That is exactly what a large,
# multi-IP, short-TTL CDN looks like from here: the client connected to
# whatever address its resolver handed out, Squid re-resolves a moment
# later and gets a different rotation of the same pool. During the
# 2026-09-10 window this filled `.30`'s cache.log for clients*.google.com,
# encrypted-tbn0.gstatic.com, lh3.googleusercontent.com, and
# Crunchyroll's own video CDN vod-*.crunchyrollcdn.com -- breaking normal
# browsing and CR playback alike once all of a device's 443 was forced
# through Squid.
#
# `off` makes Squid treat the intercepted TCP destination as
# authoritative (log the discrepancy, carry on) instead of erroring --
# the documented setting for an intercepting proxy. It does NOT weaken
# the per-domain / per-path / per-show enforcement below: that runs on
# the SNI and the decrypted request, not on this DNS-round-trip
# comparison. Unrelated to the item-7 self-IP redirect carve-out
# (nftables-manager) and to bump-mode domains (still fully decrypted).
host_verify_strict off


# ==========================================================
# SSL BUMP STEPS
# ==========================================================

acl step1 at_step SslBump1
acl step2 at_step SslBump2
acl CONNECT method CONNECT
acl SSL_ports port 443


# ==========================================================
# PER-DOMAIN MODE DECISIONS (checked via SNI, before decryption)
# ==========================================================
# Same script, three modes -- see proxy/sni_helper.py.
#
# The trailing %DATA on every external_acl_type line below is required, not
# decorative: Squid always appends a %DATA field to the line it sends a
# helper unless the FORMAT already includes one (squid.conf.documented,
# external_acl_type). None of the `acl ... external ...` lines below pass a
# static argument, so %DATA is always the literal string "-" -- but it is
# still sent, making every line one field longer than its %macro count
# suggests. Omitting it here previously meant every helper's field_count
# was off by one, so every single request was rejected as a malformed line
# and fell through to the terminate-all catch-all -- discovered against a
# real Squid instance (see docs/review-2026-08-28.md).
#
# %LOGIN is gone from every FORMAT below (2026-08-30, intercept mode): an
# intercepted connection has no CONNECT handshake for Squid to challenge
# with a 407, so there is no per-request login to pass. %>a (the client's
# source IP) is now the only identity signal, resolved on the Python side
# via common/device_identity.py (source IP -> device_bindings ->
# devices.user_id) -- the same identity data the DNS tier already relies on.

external_acl_type sni_bump_check children-max=10 ttl=0 negative_ttl=0 \
%>a %ssl::>sni %DATA \
/usr/bin/python3 /opt/optigate/sni_helper.py bump

external_acl_type sni_trusted_check children-max=10 ttl=0 negative_ttl=0 \
%>a %ssl::>sni %DATA \
/usr/bin/python3 /opt/optigate/sni_helper.py trusted

external_acl_type sni_splice_check children-max=10 ttl=0 negative_ttl=0 \
%>a %ssl::>sni %DATA \
/usr/bin/python3 /opt/optigate/sni_helper.py splice

external_acl_type sni_block_page_check children-max=10 ttl=0 negative_ttl=0 \
%>a %ssl::>sni %DATA \
/usr/bin/python3 /opt/optigate/sni_helper.py block_page

acl sni_bump external sni_bump_check
acl sni_trusted external sni_trusted_check
acl sni_splice_allowed external sni_splice_check
acl sni_show_block_page external sni_block_page_check


# ==========================================================
# HTTP-LAYER DECISION (only reached for bump-mode domains,
# once decrypted -- domain assignment, paths, Crunchyroll shows)
# ==========================================================

external_acl_type authz_check children-max=20 ttl=0 negative_ttl=0 \
%>a %DST %PATH %DATA \
/usr/bin/python3 /opt/optigate/authz_helper.py

acl authz_allowed external authz_check


# ==========================================================
# HTTP ACCESS RULES
# ==========================================================

http_access allow localhost

# No per-request login to check anymore (see the PORT/TLS section above) --
# identity is resolved from the client's source IP instead, inside
# sni_helper.py/authz_helper.py themselves. Every device that reaches this
# proxy at all already got here via nftables' bump_v4 redirect, which only
# ever applies to an already-authenticated, admin-opted-in device (see
# RoadMap.md's "two independent axes" section) -- there is deliberately no
# `http_access deny !authenticated` equivalent left here.

# This is an HTTPS filtering proxy: CONNECT is only ever needed to port 443.
# Refusing everything else stops the proxy being used as a generic TCP tunnel
# (SSH-over-CONNECT, SMTP, etc.).
http_access deny CONNECT !SSL_ports

# Allow the CONNECT tunnel and TLS peek/bump negotiation -- the actual
# allow/deny decision happens in the ssl_bump rules below (splice/bump/
# terminate) and, for bump-mode domains, in authz_allowed.
#
# step1/step2 MUST be qualified with CONNECT here, not left bare. Squid's
# at_step state for a connection does not reset once ssl_bump reaches step2
# -- the first decrypted HTTP request that follows a bump decision is *also*
# evaluated with step2 still true. A bare `http_access allow step2` therefore
# grants that real, decrypted request unconditional access via this rule,
# before authz_allowed is ever reached -- completely bypassing per-domain,
# per-path, and per-show enforcement for every bump-mode request (Crunchyroll
# included). Confirmed against a real Squid instance: an unapproved show's
# page loaded successfully with a bare `allow step2`, and was correctly
# denied once qualified with CONNECT (see docs/review-2026-08-28.md). The
# decrypted inner request's method is GET/POST/etc., never CONNECT, so
# qualifying these rules with CONNECT confines them to the tunnel/negotiation
# phase exactly as intended, leaving authz_allowed as the real gate.
http_access allow CONNECT
http_access allow CONNECT step1
http_access allow CONNECT step2

# Final decision for fully-decrypted (bump-mode) requests.
http_access allow authz_allowed
# A deny_info line for authz_allowed (pointing blocked bump-mode requests
# at a friendly page) is appended here by entrypoint.sh if DASHBOARD_URL
# is configured -- omitted entirely otherwise, since deny_info requires a
# non-empty argument and envsubst can't conditionally drop a line.

# Deliberately NOT flipped to `allow all` despite RoadMap.md's "AdGuard
# becomes the authoritative domain-level gate" framing: that framing is only
# true once the AdGuard hard-deny integration actually exists (RoadMap.md's
# changes-needed checklist item -- not built yet). Until then, Squid is
# still the only thing standing between an unconfigured/unassigned domain
# and a bump-enabled device, for BOTH plain HTTP (falls through to here
# directly, no ssl_bump involved) and any bump-mode HTTPS request
# authz_allowed didn't approve. Deny-by-default preserves the exact
# enforcement this project already had; revisit once the AdGuard item ships.
http_access deny all


# ==========================================================
# SSL BUMP DECISION CHAIN
# ==========================================================
# Order matters -- first match wins.

ssl_bump peek step1

# trusted: always splice, never checked (raw CDN traffic)
ssl_bump splice step2 sni_trusted

# bump: fully decrypt for path/show-level rules
ssl_bump bump step2 sni_bump

# splice (default mode): host-only check via SNI, no decryption
ssl_bump splice step2 sni_splice_allowed

# Everything else is already going to be denied -- an unconfigured domain,
# or a splice-mode domain this user isn't permitted. If block_page_mode is
# 'redirect' (the default, editable from Settings), bump it anyway so the
# HTTP-layer deny (authz_helper.py) can serve a real page instead of a bare
# connection failure -- this means the proxy briefly sees that one
# connection's Host+Path before denying it, a deliberate tradeoff for a
# better experience. If block_page_mode is 'terminate', this rule always
# says no, and nothing here is ever decrypted.
ssl_bump bump step2 sni_show_block_page

# True catch-all: terminate rather than bump-and-deny, since there's
# nothing to gain from decrypting traffic we're not going to explain either.
#
# Deliberately kept as `terminate`, NOT flipped to `splice`, despite
# RoadMap.md's changes-needed checklist listing that flip as part of this
# item. That checklist entry itself flagged the reason to look closer before
# doing it: "whether sni_trusted_check/sni_splice_check/sni_block_page_check
# still each pull their own weight once AdGuard is the domain-level gate
# needs a closer look... not assumed here." Looking closer: flipping this
# now, before the AdGuard hard-deny integration exists (a separate,
# not-yet-started checklist item), would be a real regression, not a
# no-op -- this exact line is what `block_page_mode = 'terminate'` (the
# default) relies on to actually deny an unconfigured domain or a
# splice-mode domain this user isn't assigned. sni_show_block_page's ERR
# falls through to precisely this line; flipping it to splice would make
# 'terminate' mode silently splice those domains through unfiltered instead
# -- worse than doing nothing, since the setting would say one thing and do
# another. Revisit together with the AdGuard item, once it's actually the
# authoritative gate this comment would need it to be.
ssl_bump terminate step2 all


# ==========================================================
# PERFORMANCE
# ==========================================================

# No disk cache is configured. Also refuse to hold responses in the memory
# cache: on a bumped connection that would mean one user's decrypted content
# could be served to another.
cache deny all

quick_abort_min -1 KB
quick_abort_max 0 KB
quick_abort_pct 95

read_ahead_gap 1 MB

client_persistent_connections on
server_persistent_connections on

persistent_request_timeout 60 seconds
