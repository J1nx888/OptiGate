# Copy this to .env and fill in your own values, or just run ./setup.sh.
# Every value here is optional -- sensible defaults apply if a line is missing.

# LAN CIDR(s) allowed to use the proxy, space-separated if more than one.
# Editable later from the dashboard's Settings page without restarting.
#
# NOTE: this check only works when the proxy sees real client IPs. The proxy
# service runs with `network_mode: host` (docker-compose.yml, since
# 2026-08-30 -- also required for Squid's intercept mode to work at all, see
# RoadMap.md), so this is true on a native Linux Docker host, which is the
# only supported deployment target. Docker Desktop (Windows/Mac) doesn't
# support network_mode: host the same way and would see an internal address
# instead, rejecting every request -- if you're testing under Docker Desktop,
# leave this blank to disable the check (see docs/security/overview.md for
# what's left gating Squid access once this is off).
LOCAL_NETWORK=192.168.1.0/24

# Phase 8: default IANA time zone new Schedules (dashboard's Schedules page)
# are created with -- only read on first run to seed this setting; editable
# from Settings afterwards. Each schedule stores its own time zone once
# created, so changing this later never moves an already-created schedule's
# meaning. Example: America/Chicago
HOUSEHOLD_TIME_ZONE=UTC

# Dashboard admin login. Only read on first run to seed the account; editable
# from Settings afterwards. If DASHBOARD_PASSWORD is left blank, a random one
# is generated on first start and printed to the dashboard container's logs
# (`docker compose logs dashboard`). Separate from the per-person usernames/
# passwords you create for household members under Users -- as of 2026-08-30
# those aren't checked by anything (Squid now resolves identity from the
# device itself, not a login; see RoadMap.md's Squid intercept-mode section).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# 127.0.0.1 = dashboard only reachable from this machine (use SSH
# port-forwarding for remote access). 0.0.0.0 = reachable from any device
# on your LAN. Since 2026-08-30 this feeds directly into the dashboard's
# own listen address (network_mode: host, same reason as ADGUARD_WEB_BIND
# above -- needed so it can reach AdGuard's loopback-bound admin API) --
# same two options as before, just no longer implemented via a Docker
# port-publish mapping.
DASHBOARD_BIND=127.0.0.1

# Optional: if set (e.g. http://192.168.1.50:8787), blocked bump-mode
# requests (Crunchyroll, or any other domain you've set to "bump" mode)
# redirect to a friendly explanation page instead of a bare connection
# error. Leave blank to skip this -- browsers will just show a generic
# error for blocked bump-mode sites. Note this only applies to bump-mode
# domains; splice-mode blocks never show a page (see README).
DASHBOARD_URL=

# AdGuard Home admin login (its OWN admin UI, separate from this project's
# dashboard) -- consumed by adguard/entrypoint.sh's automated first-run
# setup, to seed the dashboard's own copy of these same settings (used by
# its Settings page's "Check for filter updates now" button), AND by
# controller/main.py once the interception profile starts (it calls
# AdGuard's own API to sync block rules). Leave this BLANK ONLY if you're
# using ./setup.sh, which generates a real value here before anything
# ever starts -- see the real bug this fixes in RoadMap.md's 2026-09-07
# entry ("Soak test paused after ~15 minutes"): a blank value here used
# to work for adguard's own first-run bootstrap (which safely
# self-generates one) but left controller with no way to ever learn that
# same generated value, since it only ever reached the adguard
# container's own logs, not .env. If you're filling in .env by hand
# instead of running ./setup.sh, set a real password here yourself.
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=

# 127.0.0.1 = AdGuard Home's own admin UI only reachable from this machine.
# 0.0.0.0 = reachable from any device on the LAN. Independent of
# DASHBOARD_BIND above -- this is a second, separate admin login surface.
# The dashboard's own Settings page (2026-09-07) links to this UI for a
# quick click-through to AdGuard's own stats/query-log view -- that link
# only actually loads if this is set to something other than the
# 127.0.0.1 default, same as DASHBOARD_BIND itself.
ADGUARD_WEB_BIND=127.0.0.1

# Where the dashboard container reaches AdGuard Home's control API from --
# both run with network_mode: host (see docker-compose.yml), so this is
# just the loopback address regardless of ADGUARD_WEB_BIND above. Only
# needs changing if AdGuard is ever moved to a different host/port.
ADGUARD_URL=http://127.0.0.1:3000

# On first run, a curated set of uBlockOrigin/uAssets domain-blocking lists
# (ads/badware/privacy trackers/resource abuse, plus their matching
# exceptions list) are added on top of AdGuard's own default filter (already
# enabled automatically -- this is a genuine addition, not a replacement).
# Set to 1 to skip this and keep only AdGuard's own default filter.
ADGUARD_SKIP_EXTRA_BLOCKLISTS=

# How often AdGuard itself re-checks every subscribed filter list, in hours
# -- 168 = once a week. Independent of the dashboard's "Check for filter
# updates now" button, which works on demand regardless of this setting.
ADGUARD_FILTERS_UPDATE_INTERVAL_HOURS=168
